{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vendor-coi-chasing.local/schemas/coi-extraction.schema.json",
  "title": "COI extraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "is_certificate_of_insurance",
    "vendor_legal_name",
    "vendor_address",
    "producer_name",
    "producer_email",
    "producer_phone",
    "certificate_date",
    "certificate_holder",
    "coverages",
    "description_of_operations",
    "cancellation_notice_wording",
    "extraction_confidence",
    "confidence_reason"
  ],
  "properties": {
    "is_certificate_of_insurance": {
      "type": "boolean"
    },
    "vendor_legal_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "vendor_address": {
      "type": [
        "string",
        "null"
      ]
    },
    "producer_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "producer_email": {
      "type": [
        "string",
        "null"
      ]
    },
    "producer_phone": {
      "type": [
        "string",
        "null"
      ]
    },
    "certificate_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "certificate_holder": {
      "type": [
        "string",
        "null"
      ]
    },
    "coverages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "insurer_name",
          "naic",
          "policy_number",
          "effective_date",
          "expiration_date",
          "each_occurrence",
          "general_aggregate",
          "addl_insd_asserted",
          "subr_wvd_asserted"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "GENERAL_LIABILITY",
              "AUTO",
              "UMBRELLA",
              "WORKERS_COMP",
              "OTHER"
            ]
          },
          "insurer_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "naic": {
            "type": [
              "string",
              "null"
            ]
          },
          "policy_number": {
            "type": [
              "string",
              "null"
            ]
          },
          "effective_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "expiration_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "each_occurrence": {
            "type": [
              "number",
              "null"
            ]
          },
          "general_aggregate": {
            "type": [
              "number",
              "null"
            ]
          },
          "addl_insd_asserted": {
            "type": "boolean"
          },
          "subr_wvd_asserted": {
            "type": "boolean"
          }
        }
      }
    },
    "description_of_operations": {
      "type": [
        "string",
        "null"
      ]
    },
    "cancellation_notice_wording": {
      "type": [
        "string",
        "null"
      ]
    },
    "extraction_confidence": {
      "type": "string",
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "confidence_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
