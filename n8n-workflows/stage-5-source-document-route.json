      "webhookId": "stage-5-source-document-webhook"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  c.id,\n  c.original_filename,\n  c.stored_path,\n  (c.stored_path LIKE '/home/node/.n8n-files/certificates/%') AS safe_path\nFROM (SELECT $1::int AS certificate_id) req\nLEFT JOIN certificates c ON c.id = req.certificate_id;",
        "options": {
          "queryReplacement": "={{ $json.params.certificate_id }}"
        }
      },
