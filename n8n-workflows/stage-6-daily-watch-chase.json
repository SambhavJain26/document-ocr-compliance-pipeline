        "responses": {
          "values": [
            {
              "type": "text",
              "role": "user",
              "content": "=Draft the certificate paperwork request.\n\nVendor: {{ $json.vendor_legal_name }}\nTrade: {{ $json.trade || \"Unknown\" }}\nProducer: {{ $json.producer_name || \"Unknown\" }}\nPolicy number: {{ $json.policy_number || \"not on file\" }}\nExpiration date: {{ $json.expiration_date || \"not on file\" }}\nBucket: {{ $json.bucket }}\nCertificate holder: Harbourline Property Management LLC\nRecipient: {{ $json.intended_recipient }}"
            }
          ]
        },
        "simplify": true,
        "builtInTools": {},
        "options": {
          "instructions": "You draft short certificate paperwork request emails for a US residential property management company.\n\nRules:\n- Return only JSON matching the schema.\n- Keep body under 120 words.\n- Be polite, direct, and specific.\n- Ask for an updated certificate of liability insurance naming the configured certificate holder.\n- Reference the vendor name, policy number when present, and expiration date when present.\n- Never say or imply the vendor is compliant, verified, covered, approved, insured, uninsured, safe, or unsafe.\n- This is an administrative paperwork request only.",
          "maxTokens": 350,
          "temperature": 0,
          "store": false,
          "textFormat": {
            "textOptions": {
              "type": "json_schema",
              "name": "coi_chase_email_draft",
              "schema": "{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"subject\",\"body\"],\"properties\":{\"subject\":{\"type\":\"string\"},\"body\":{\"type\":\"string\"}}}",
              "strict": true
            }
          }
        }
