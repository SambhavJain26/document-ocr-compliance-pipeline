# Runtime mode: local for the demo; production enables DNS/TLS checks.
DEPLOYMENT_MODE=local

# n8n local demo
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=America/New_York
TZ=UTC

# n8n encryption
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX
# n8n 1.0+ uses its built-in owner account. Create it in the UI on first launch.

# PostgreSQL
POSTGRES_USER=coi
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=coi
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# OpenAI
OPENAI_API_KEY=sk-proj-CHANGE_ME

# Google OAuth (Gmail node)
GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=CHANGE_ME

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard access
# Generate with: openssl rand -hex 16
DASHBOARD_TOKEN=CHANGE_ME_HEX

# Production TLS only (unused for localhost)
ACME_EMAIL=
