# Copy this file to .env with scripts/init-env.ps1.
# Never commit .env. It contains generated local secrets.

COMPOSE_PROJECT_NAME=vendor-coi-chasing

POSTGRES_DB=vendor_coi
POSTGRES_USER=vendor_coi
POSTGRES_PASSWORD=replace-with-generated-local-password
POSTGRES_PORT=5432
PGWEB_PORT=8081
PGWEB_USER=coi_readonly
PGWEB_PASSWORD=replace-with-generated-pgweb-password

N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678
N8N_EDITOR_BASE_URL=http://localhost:5678
GENERIC_TIMEZONE=America/New_York
N8N_ENCRYPTION_KEY=replace-with-generated-local-encryption-key
N8N_SECURE_COOKIE=false
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false

# Manual n8n credential guidance only. Store API keys in n8n credentials, not here.
OPENAI_MODEL_ID=gpt-5.4-nano
OPENAI_MODEL_ID_FALLBACK=gpt-5.6-luna
OPENAI_SPEND_LIMIT_USD=10
TELEGRAM_ENABLED=false
