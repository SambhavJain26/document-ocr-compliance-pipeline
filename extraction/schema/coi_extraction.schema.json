{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "is_certificate_of_insurance",
    "vendor_legal_name",
    "vendor_address",
    "producer_name",
    "producer_contact_name",
    "producer_email",
    "producer_phone",
    "certificate_date",
    "certificate_holder",
    "certificate_holder_address",
    "coverages",
    "description_of_operations",
    "cancellation_notice_wording",
    "extraction_confidence",
    "confidence_reason"
  ],
  "properties": {
    "is_certificate_of_insurance": { "type": "boolean" },
    "vendor_legal_name": { "type": ["string", "null"], "description": "INSURED name exactly as printed." },
    "vendor_address": { "type": ["string", "null"] },
    "producer_name": { "type": ["string", "null"] },
    "producer_contact_name": { "type": ["string", "null"] },
    "producer_email": { "type": ["string", "null"] },
    "producer_phone": { "type": ["string", "null"] },
    "certificate_date": { "type": ["string", "null"], "description": "ISO YYYY-MM-DD." },
    "certificate_holder": { "type": ["string", "null"] },
    "certificate_holder_address": { "type": ["string", "null"] },
    "coverages": {
      "type": "array",
      "description": "One object per present coverage line; never invent a line.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "insurer_name",
          "naic",
          "policy_number",
          "effective_date",
          "expiration_date",
          "each_occurrence",
          "general_aggregate",
          "addl_insd_asserted",
          "subr_wvd_asserted"
        ],
        "properties": {
          "type": { "type": "string", "enum": ["GENERAL_LIABILITY", "AUTO", "UMBRELLA", "WORKERS_COMP", "OTHER"] },
          "insurer_name": { "type": ["string", "null"] },
          "naic": { "type": ["string", "null"] },
          "policy_number": { "type": ["string", "null"] },
          "effective_date": { "type": ["string", "null"], "description": "ISO YYYY-MM-DD." },
          "expiration_date": { "type": ["string", "null"], "description": "ISO YYYY-MM-DD." },
          "each_occurrence": { "type": ["number", "null"], "description": "Integer without symbols or separators." },
          "general_aggregate": { "type": ["number", "null"] },
          "addl_insd_asserted": { "type": ["boolean", "null"], "description": "Whether a form checkbox is marked; an assertion, not a coverage determination." },
          "subr_wvd_asserted": { "type": ["boolean", "null"], "description": "Whether a form checkbox is marked; an assertion, not a coverage determination." }
        }
      }
    },
    "description_of_operations": { "type": ["string", "null"] },
    "cancellation_notice_wording": { "type": ["string", "null"], "description": "Verbatim notice wording, if present." },
    "extraction_confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
    "confidence_reason": { "type": ["string", "null"], "description": "One plain-English sentence when confidence is MEDIUM or LOW." }
  }
}
